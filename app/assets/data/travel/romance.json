[
  {"mn":"Чи гоё.","ko":"너 예뻐.","pron":"치 고요","grammar":"몽골어는 be동사 없이 형용사가 그대로 술어가 됨. 'гоё(예쁜·멋진)'를 주어 'чи(너)' 뒤에 두면 '너는 ~다'. 한국어 '너 예뻐'와 같은 구조.","focus":"형용사 술어"},
  {"mn":"Чи сайхан хүн.","ko":"너 좋은 사람이야.","pron":"치 새한 훈","grammar":"'сайхан(좋은)+хүн(사람)'처럼 수식어가 명사 앞에 옴(한국어와 동일). 계사 없이 'A는 B다' 명사술어문.","focus":"명사 술어"},
  {"mn":"Би үнэхээр баяртай байна.","ko":"나 정말 행복해.","pron":"비 우네헤르 바야르태 밴","grammar":"'баяртай(기쁜)+байна(있다)'로 현재 상태 '~다'를 나타냄. байна는 현재시제 계사. 'үнэхээр(정말)'는 정도부사.","focus":"байна(현재)"},
  {"mn":"Би чамд хайртай.","ko":"나는 너를 좋아해.","pron":"비 참드 하이르태","grammar":"'хайртай(사랑하는)'는 여격(-д/에게)을 지배함. чи의 여격형은 불규칙 'чамд(너에게)'. 직역 '너에게 사랑이 있다'=너를 좋아해.","focus":"여격 чамд(에게)"},
  {"mn":"Чи надад таалагдаж байна.","ko":"나 너 마음에 들어.","pron":"치 나다드 탈락다지 밴","grammar":"'таалагдах(마음에 들다)'는 대상이 주어, 느끼는 사람이 여격. би의 여격 'надад(나에게)'. '네가 나에게 마음에 든다'.","focus":"여격 надад(에게)"},
  {"mn":"Би чамайг санаж байна.","ko":"나 너 보고 싶어.","pron":"비 차마이그 사나지 밴","grammar":"'санах(그리워하다)'는 타동사라 목적격을 취함. чи의 목적격은 불규칙 'чамайг(너를)'. '-ж байна'는 현재진행 '~하고 있다'.","focus":"목적격 чамайг(를)"},
  {"mn":"Би чамайг санасан.","ko":"나 너 보고 싶었어.","pron":"비 차마이그 사나승","grammar":"동사어간 'сана-'+과거 '-сан'. 어간 모음이 남성(а)이라 -сан(여성모음이면 -сэн). '보고 싶었어/그리웠어'.","focus":"과거 -сан(었다)"},
  {"mn":"Чи онцгой хүн.","ko":"너 특별한 사람이야.","pron":"치 온츠고이 훈","grammar":"'онцгой(특별한)+хүн(사람)' 형용사+명사. 계사 없는 명사술어문으로 '너는 특별한 사람이다'.","focus":"명사 술어"},
  {"mn":"Чи надад маш онцгой.","ko":"너 나에게 아주 특별해.","pron":"치 나다드 마시 온츠고이","grammar":"'над(나)'의 여격 'надад(나에게)'로 한국어 '에게'를 표현. 'маш(아주)'는 정도부사. 형용사 술어 онцгой.","focus":"여격 надад(에게)"},
  {"mn":"Би чамтай уулзмаар байна.","ko":"나 너 만나고 싶어.","pron":"비 참태 올즈마르 밴","grammar":"'уулз-(만나다)'+욕구 '-маар'='~하고 싶다'. 어간 모음 у(남성)라 -маар(여성 -мээр). 공동격 'чамтай(너와)'는 -тай.","focus":"-маар(싶다)"},
  {"mn":"Дахиад уулзъя.","ko":"또 만나자.","pron":"다히아드 올지야","grammar":"'уулз-'+1인칭 청유 '-ъя'='~하자'. 남성·중성모음 어간엔 -ъя, 여성모음엔 -ье. 'дахиад(다시)'는 부사.","focus":"청유 -ъя(하자)"},
  {"mn":"Маргааш уулзъя.","ko":"내일 만나자.","pron":"마르가시 올지야","grammar":"같은 청유 '-ъя(하자)'. 'маргааш(내일)'는 시간부사로 문두에 옴. 한국어 '내일 만나자'와 어순 동일.","focus":"청유 -ъя(하자)"},
  {"mn":"Холбоо барьцгаая.","ko":"우리 연락하자.","pron":"홀보 바리츠가야","grammar":"'холбоо барих(연락하다)'. '-цгаа-'는 복수·공동 행위 표지, 거기에 청유 '-я'가 붙어 '함께 ~하자'. 어간 모음 а라 -цгаая.","focus":"청유복수 -цгаая"},
  {"mn":"Надад бичээрэй.","ko":"나한테 (문자) 보내줘.","pron":"나다드 비체레이","grammar":"'бич-(쓰다)'+공손명령 '-ээрэй(해줘)'. 어간 모음 и(중성)라 -ээрэй가 결합. 여격 'надад(나에게)'.","focus":"명령 -ээрэй(해줘)"},
  {"mn":"Надад утсаар яриарай.","ko":"나한테 전화해.","pron":"나다드 오트사르 야리아라이","grammar":"'утсаар(전화로)'는 도구격 -аар. 'ярь-(말하다)'+공손명령 '-аарай'='яриарай'. '전화로 말해줘'.","focus":"도구격 -аар(로)"},
  {"mn":"Сайн яваарай.","ko":"잘 가.","pron":"사인 야와라이","grammar":"'яв-(가다)'+공손명령 '-аарай'(남성모음 а). 'сайн(잘)'. 떠나는 사람에게 하는 작별 인사.","focus":"명령 -аарай(해)"},
  {"mn":"Болгоомжтой яваарай.","ko":"조심히 가.","pron":"볼고옴즈토이 야와라이","grammar":"'болгоомжтой(조심스럽게)'+'яваарай(가)'. -той는 '~을 지닌'의 부사적 용법. 같은 공손명령 -аарай.","focus":"명령 -аарай(해)"},
  {"mn":"Замдаа болгоомжтой яваарай.","ko":"가는 길 조심해.","pron":"잠다 볼고옴즈토이 야와라이","grammar":"'зам(길)'+여격 'замд'+재귀소유 '-аа'='замдаа(자기 길에서)'. 재귀소유는 주어 자신의 것을 가리킴.","focus":"재귀소유 -аа"},
  {"mn":"Баяртай.","ko":"잘 있어, 안녕.","pron":"바야르태","grammar":"'баяртай(기쁨이 있는)'가 헤어질 때의 관용 작별 인사로 굳어진 표현. 한국어 '안녕히/잘 가'에 해당.","focus":"작별 인사"},
  {"mn":"Дараа уулзъя.","ko":"다음에 보자.","pron":"다라 올지야","grammar":"'дараа(다음에)'+청유 '-ъя(하자)'. уулзъя는 уулз-+-ъя. 가벼운 작별 표현 '나중에 또 봐'.","focus":"청유 -ъя(하자)"},
  {"mn":"Би чамайг хүлээж байна.","ko":"나 너 기다리고 있어.","pron":"비 차마이그 훌레지 밴","grammar":"'хүлээх(기다리다)'의 목적어에 목적격 'чамайг(너를)'. '-ж байна'는 현재진행 '~하는 중이다'.","focus":"목적격+현재진행"},
  {"mn":"Чамтай байхад сайхан.","ko":"너와 있으면 좋아.","pron":"참태 배하드 새한","grammar":"공동격 'чамтай(너와)'. 'байх(있다)'+여격 '-д'로 '~할 때/하면'='байхад'. 'сайхан(좋다)' 술어.","focus":"공동격 -тай + -хад(때)"},
  {"mn":"Чи миний зүрхэнд байна.","ko":"너는 내 마음속에 있어.","pron":"치 미니 주르헹드 밴","grammar":"'зүрх(심장)'+여격 'зүрхэнд(마음에)'. 'миний(나의)'는 би의 속격. 'байна(있다)' 존재 표현.","focus":"여격 -д(에)"},
  {"mn":"Чамгүй надад уйтгартай.","ko":"너 없으면 나 쓸쓸해.","pron":"참귀 나다드 오이트가르태","grammar":"'-гүй(없는·없이)' 부정 접미사. 'чам(너)+гүй=чамгүй(너 없이)'. 여격 'надад', 'уйтгартай(쓸쓸한)' 술어.","focus":"-гүй(없이)"},
  {"mn":"Би чамайг санана.","ko":"나는 너를 그리워할 거야.","pron":"비 차마이그 사난","grammar":"'сана-'+현재·미래 '-на'(남성모음 а; 여성이면 -нэ). 일상적·미래의 사실을 나타내 '그리워할 거야/늘 그립다'.","focus":"미래 -на(할거야)"},
  {"mn":"Бид дахин уулзана.","ko":"우리 다시 만날 거야.","pron":"비드 다힝 올잔","grammar":"'уулз-'+미래 '-на'='уулзана(만날 것이다)'. 'бид(우리)', 'дахин(다시)'. 의지·예정의 미래.","focus":"미래 -на(할거야)"},
  {"mn":"Би чамд бэлэг өгье.","ko":"너에게 선물 줄게.","pron":"비 참드 벨릭 우기예","grammar":"'өг-(주다)'+청유 '-ье'. 어간 모음 ө(여성)라 -ье(남성·중성은 -ъя). 여격 'чамд(너에게)'.","focus":"청유 -ье(할게)"},
  {"mn":"Чи над руу залгаарай.","ko":"나한테 전화해.","pron":"치 나드 로 잘가라이","grammar":"'над руу(나에게로)'의 후치사 руу/рүү는 방향 '~쪽으로'. 'залга-(전화 걸다)'+공손명령 '-аарай'.","focus":"후치사 руу(쪽으로)"},
  {"mn":"Чамтай хамт байя.","ko":"너랑 같이 있자.","pron":"참태 함트 바이야","grammar":"공동격 'чамтай(너와)'+'хамт(함께)'. 'бай-(있다)'+청유 '-я'='байя'. '함께 있자'.","focus":"청유 -я + хамт"},
  {"mn":"Чи надтай уулзах уу?","ko":"나랑 만날래?","pron":"치 나드태 올자흐 오","grammar":"공동격 'надтай(나와)'. 동사 미래형 'уулзах'+의문조사 'уу?'. 남성모음 뒤엔 уу, 여성모음 뒤엔 үү.","focus":"의문 уу + 공동격 -тай"},
  {"mn":"Чамтай ярихад таатай.","ko":"너랑 얘기하면 편해.","pron":"참태 야리하드 타태","grammar":"공동격 'чамтай(너와)'. 'ярь-(말하다)'+'-хад(할 때/하면)'='ярихад'. 'таатай(기분 좋은)' 술어.","focus":"공동격 + -хад(면)"},
  {"mn":"Би чамайг хэзээ ч мартахгүй.","ko":"나는 너를 절대 안 잊어.","pron":"비 차마이그 헤제 치 마르타흐귀","grammar":"'март-(잊다)'+미래부정 '-хгүй'='안 ~할 것'. 'хэзээ ч(언제도→절대)'. 목적격 'чамайг(너를)'.","focus":"부정미래 -хгүй"},
  {"mn":"Бид хол боловч ойрхон.","ko":"우리 멀어도 가까워.","pron":"비드 홀 볼로프치 오이르홍","grammar":"'боловч(~지만·~해도)'는 양보 접속사. 'хол(멀다)'와 'ойрхон(가깝다)'을 대조. 장거리 연애 위로.","focus":"양보 боловч(지만)"},
  {"mn":"Хол байсан ч би чамд хайртай.","ko":"멀리 있어도 사랑해.","pron":"홀 배승 치 비 참드 하이르태","grammar":"'과거형 байсан+ч'로 '~했어도/하더라도' 양보를 나타냄. 'байсан ч(있어도)'. 여격 'чамд'+хайртай.","focus":"양보 ...ч(해도)"},
  {"mn":"Чамайг ирэхийг хүлээнэ.","ko":"네가 오기를 기다릴게.","pron":"차마이그 이레히그 훌렌","grammar":"동사 'ирэх(오다)'+목적격 '-ийг'='ирэхийг(오는 것을)' 동명사 목적어. 'хүлээ-'+미래 '-нэ'(여성모음).","focus":"동명사 목적격 -ийг"},
  {"mn":"Чамайг бодоод л байна.","ko":"자꾸 네 생각만 나.","pron":"차마이그 보도드 일 밴","grammar":"'бод-(생각하다)'+연결 '-оод'(남성모음 о)+'л байна'로 '계속 ~하고만 있다' 반복·지속. 목적격 'чамайг'.","focus":"-оод л байна(자꾸)"},
  {"mn":"Чи над дээр ирээрэй.","ko":"나한테 와.","pron":"치 나드 데르 이레레이","grammar":"'над дээр(나에게/내 쪽으로)'의 후치사 дээр. 'ир-(오다)'+공손명령 '-ээрэй'(모음 и→-ээрэй).","focus":"후치사 дээр(에게로)"},
  {"mn":"Ирэх жил Монголд эргэж ирнэ.","ko":"내년에 몽골에 다시 올게.","pron":"이레흐 질 몽골드 에르게지 이른","grammar":"'эргэж ирэх(돌아오다)'+미래 '-нэ'(여성모음 э). 'Монгол+д(몽골에)' 여격. 'ирэх жил(내년)'.","focus":"미래 -нэ(할게)"},
  {"mn":"Чамтай учирсандаа баяртай байна.","ko":"너를 만나서 기뻐.","pron":"참태 오치르산다 바야르태 밴","grammar":"'учрах(만나다)'+과거 '-сан'+재귀여격 '-даа'='учирсандаа'로 원인 '~한 것이/해서'. 공동격 'чамтай'.","focus":"과거동명사+여격 -даа(어서)"},
  {"mn":"Утасны дугаараа өгөөч.","ko":"전화번호 줘.","pron":"오타스니 도가라 우구치","grammar":"'өг-(주다)'+부드러운 부탁 '-өөч(해줘)'(여성모음 ө). 'дугаар+аа(자기 번호를)' 재귀소유. 'утасны(전화의)' 속격.","focus":"부탁 -өөч(해줘)"},
  {"mn":"Хол байсан ч хайраа хадгалъя.","ko":"멀어도 사랑 지키자.","pron":"홀 배승 치 하이라 하드갈리야","grammar":"양보 'байсан ч(있어도)'. 'хайр+аа(자기 사랑을)' 재귀소유 목적어. 'хадгал-(지키다)'+청유 '-ъя'(남성모음 а).","focus":"청유 -ъя(하자)"},
  {"mn":"Намайг бүү мартаарай.","ko":"나 잊지 마.","pron":"나마이그 부 마르타라이","grammar":"부정명령은 '동사 앞에 бүү'='~하지 마'. 'март-+аарай=мартаарай'에 бүү를 붙임. 목적격 'намайг(나를)'.","focus":"부정명령 бүү(하지마)"},
  {"mn":"Чи надтай болзох уу?","ko":"나랑 데이트할래?","pron":"치 나드태 볼조흐 오","grammar":"'болзох(데이트·약속하다)'. 공동격 'надтай(나와)'. 동사 뒤 의문조사 'уу?'(남성모음). 데이트 신청 표현.","focus":"공동격 -тай + 의문 уу"},
  {"mn":"Энэ аяллыг хэзээ ч мартахгүй.","ko":"이 여행을 절대 못 잊어.","pron":"엔 아얄리그 헤제 치 마르타흐귀","grammar":"'аялал+ыг(여행을)' 목적격(남성모음이라 -ыг, 여성은 -ийг). 'хэзээ ч(절대)'+부정미래 'мартахгүй'.","focus":"목적격 -ыг(를)"},
  {"mn":"Чи надад их үнэтэй хүн.","ko":"너는 나에게 소중한 사람이야.","pron":"치 나다드 이흐 우네테이 훈","grammar":"'үнэтэй(값진·소중한)'+'хүн(사람)'. 여격 'надад(나에게)'로 '에게'. 'их(매우)' 정도부사.","focus":"여격 надад(에게)"},
  {"mn":"Чамд хайртайгаа хэлье.","ko":"너 좋아한다고 말할게.","pron":"참드 하이르태가 헬리예","grammar":"'хайртай+гаа'로 '사랑함을'(재귀+목적). 'хэл-(말하다)'+청유 '-ье'(여성모음 э). 여격 'чамд'.","focus":"청유 -ье(할게)"},
  {"mn":"Хэдийгээр хол ч сэтгэл нэг.","ko":"비록 멀어도 마음은 하나야.","pron":"헤디게르 홀 치 세트겔 넥","grammar":"'хэдийгээр ... ч(비록 ~지만)' 양보 구문. 'хол(멀다)'와 'сэтгэл нэг(마음이 하나)'를 대조.","focus":"양보 хэдийгээр(비록)"},
  {"mn":"Дараагийн удаа хамт аялъя.","ko":"다음엔 같이 여행하자.","pron":"다라긴 오다 함트 아얄리야","grammar":"'аял-(여행하다)'+청유 '-ъя'(남성모음 а). 'дараагийн удаа(다음 번)', 'хамт(함께)'. '함께 여행하자'.","focus":"청유 -ъя(하자)"},
  {"mn":"Чамайгаа сэтгэлээсээ хайрладаг.","ko":"진심으로 너를 사랑해.","pron":"차마이가 세트겔레세 하이를라닥","grammar":"'хайрла-(사랑하다)'+습관 '-даг'='늘 ~한다'. 'сэтгэл+ээс+ээ(마음으로부터)' 탈격+재귀. 목적격 'чамайгаа(너를)'.","focus":"습관 -даг + 탈격 -ээс"},
